{
  "name": "@switchyard-ts/ember-concurrency",
  "version": "0.3.0",
  "description": "Run ember-concurrency tasks from Switchyard @invoke: leaving the state cancels the task.",
  "keywords": [
    "ember-addon",
    "ember",
    "ember-concurrency",
    "statechart"
  ],
  "license": "MIT",
  "author": "Joe Gaudet joe@joegaudet.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/switchyard.git",
    "directory": "packages/ember-concurrency"
  },
  "homepage": "https://joegaudet.com/switchyard/",
  "bugs": "https://github.com/joegaudet/switchyard/issues",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup --config",
    "typecheck": "ember-tsc --noEmit"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3"
  },
  "peerDependencies": {
    "@switchyard-ts/core": "workspace:^",
    "@switchyard-ts/ember": "workspace:^",
    "ember-concurrency": ">= 4.0.0",
    "ember-source": ">= 6.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-typescript": "^7.29.15",
    "@babel/runtime": "^7.29.15",
    "@ember/library-tsconfig": "^3.0.0",
    "@embroider/addon-dev": "^8.5.0",
    "@glint/ember-tsc": "^1.14.4",
    "@glint/template": "^1.11.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@switchyard-ts/core": "workspace:^",
    "@switchyard-ts/ember": "workspace:^",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "ember-concurrency": "^5.3.0",
    "ember-source": "~7.3.1",
    "rollup": "^4.68.7",
    "typescript": "~6.0.3"
  }
}
