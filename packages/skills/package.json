{
  "name": "@switchyard-ts/skills",
  "version": "0.1.0",
  "description": "Installs the Switchyard authoring skill into a repo's .claude/ directory.",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "skill",
    "statechart"
  ],
  "license": "MIT",
  "author": "Joe Gaudet joe@joegaudet.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/switchyard.git",
    "directory": "packages/skills"
  },
  "homepage": "https://joegaudet.com/switchyard/",
  "bugs": "https://github.com/joegaudet/switchyard/issues",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@real-enums/core": "^2.2.0"
  },
  "devDependencies": {},
  "bin": {
    "switchyard-skills": "./dist/cli.js"
  }
}
